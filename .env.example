# Campus Customs agent — copy this file to .env (repo root or backend/) and fill in
# your key. Your real .env is gitignored and will NOT be committed.

# Your Portkey API key (required for the chatbot).
PORTKEY_API_KEY=

# Optional: a Portkey virtual key or config id, if your Portkey setup uses one.
PORTKEY_VIRTUAL_KEY=
PORTKEY_CONFIG=

# Model to use through Portkey (OpenAI 5.6 or 6 series per the assignment).
AGENT_MODEL=gpt-5.6

# Portkey's OpenAI-compatible gateway base URL (usually leave as-is).
PORTKEY_BASE_URL=https://api.portkey.ai/v1
